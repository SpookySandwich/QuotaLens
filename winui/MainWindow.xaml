<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="QuotaLens.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:QuotaLens"
    xmlns:views="using:QuotaLens.Views"
    xmlns:vm="using:QuotaLens.ViewModels"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="QuotaLens"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AmbientTintCurrent"
                Grid.RowSpan="2"
                IsHitTestVisible="False" />

        <!-- Per-pixel ±1 LSB noise over the ambient tint: WinUI composits at 8bpc
             (no 10-bit path for XAML), so the gradient can only avoid visible
             banding by dithering — the same trick Windows' acrylic uses. -->
        <Image x:Name="AmbientDitherLayer"
               Grid.RowSpan="2"
               Stretch="Fill"
               IsHitTestVisible="False" />

        <!-- ===== Custom title bar (native caption buttons preserved) ===== -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="44" Padding="8,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightInset" Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Padding="4,0,0,0">
                <Button x:Name="BackButton" Click="OnCloseSettings" Visibility="Collapsed"
                        AutomationProperties.AutomationId="BackButton"
                        Style="{StaticResource CardIconButton}">
                    <FontIcon FontSize="14" Glyph="&#xE72B;" />
                    <ToolTipService.ToolTip>
                        <TextBlock x:Name="BackButtonToolTipText" />
                    </ToolTipService.ToolTip>
                </Button>
                <Image x:Name="TitleIcon" Source="Assets/AppIcon.ico" Width="16" Height="16" Margin="4,0,2,0" />
                <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>

            <StackPanel x:Name="TitleCommandBar"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                <Button x:Name="SensitiveInfoButton"
                        Command="{x:Bind Vm.ToggleSensitiveInfoCommand}"
                        AutomationProperties.AutomationId="SensitiveInfoButton"
                        AutomationProperties.Name="{x:Bind Vm.SensitiveInfoTitle, Mode=OneWay}"
                        Style="{StaticResource CardIconButton}">
                    <FontIcon FontSize="16"
                              Glyph="{x:Bind Vm.SensitiveInfoGlyph, Mode=OneWay}" />
                    <ToolTipService.ToolTip>
                        <TextBlock Text="{x:Bind Vm.SensitiveInfoTitle, Mode=OneWay}" />
                    </ToolTipService.ToolTip>
                </Button>
                <Button x:Name="RefreshButton"
                        Command="{x:Bind Vm.RefreshAllCommand}"
                        AutomationProperties.AutomationId="RefreshAllButton"
                        AutomationProperties.Name="{x:Bind Vm.RefreshAllTitle}"
                        Style="{StaticResource CardIconButton}">
                    <Grid>
                        <ProgressRing Width="16" Height="16"
                                      IsActive="{x:Bind Vm.IsRefreshingAll, Mode=OneWay}"
                                      Visibility="{Binding IsRefreshingAll, Converter={StaticResource BoolToVis}}" />
                        <FontIcon FontSize="16" Glyph="&#xE72C;"
                                  Visibility="{Binding IsRefreshingAll, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                    <ToolTipService.ToolTip>
                        <TextBlock Text="{x:Bind Vm.RefreshAllTitle}" />
                    </ToolTipService.ToolTip>
                </Button>
                <Button x:Name="SettingsButton"
                        Command="{x:Bind Vm.OpenSettingsCommand}"
                        AutomationProperties.AutomationId="SettingsButton"
                        AutomationProperties.Name="{x:Bind Vm.SettingsTitle}"
                        Style="{StaticResource CardIconButton}">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                    <ToolTipService.ToolTip>
                        <TextBlock Text="{x:Bind Vm.SettingsTitle}" />
                    </ToolTipService.ToolTip>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Dashboard ===== -->
        <ScrollViewer x:Name="DashboardRoot" Grid.Row="1"
                      AutomationProperties.AutomationId="DashboardRoot"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="DashboardViewport">
                <StackPanel x:Name="DashboardContent"
                            Spacing="10"
                            Margin="16,10,16,16"
                            HorizontalAlignment="Center">

                <!-- Ambient dashboard summary. -->
                <Grid AutomationProperties.AutomationId="HeroSummary"
                      Padding="12,4,12,10">
                            <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{x:Bind Vm.Hero.Eyebrow}" Style="{StaticResource HeroEyebrowText}" />

                            <!-- The recommendation: which platform to use right now. -->
                            <Grid Grid.Row="1" ColumnSpacing="10"
                                  Visibility="{Binding Hero.HasPick, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                                        Background="{x:Bind Vm.Hero.PickBrush, Mode=OneWay}" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Vm.Hero.PickName, Mode=OneWay}"
                                           Style="{StaticResource HeroPickText}"
                                           MinWidth="0" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Vm.Hero.PickDetail, Mode=OneWay}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}"
                                           Foreground="{Binding Hero.PickSeverity, Converter={StaticResource SeverityToBrush}}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Empty / waiting state -->
                            <TextBlock Grid.Row="1"
                                       Text="{x:Bind Vm.Hero.EmptyText, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding Hero.HasPick, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                            <Grid Grid.Row="2" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{x:Bind Vm.Hero.NextText, Mode=OneWay}"
                                           Style="{StaticResource CaptionText}"
                                           TextWrapping="WrapWholeWords"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Hero.HasNext, Converter={StaticResource BoolToVis}}" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Vm.Hero.OnlineLabel}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Vm.Hero.OnlineValue, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding Hero.OnlineSeverity, Converter={StaticResource SeverityToBrush}}" />
                                    <TextBlock Text="{x:Bind Vm.Hero.OnlineDetail, Mode=OneWay}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            </Grid>
                </Grid>

                <!-- Aggregate usage horizon -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,14,16,12"
                        AutomationProperties.AutomationId="UsageTimelineCard"
                        AutomationProperties.Name="{x:Bind Vm.Hero.UsageTimelineAutomationName}"
                        Visibility="{Binding IsUsageTimelineVisible, Converter={StaticResource BoolToVis}}">
                    <views:UsageCylinder x:Name="UsageTimeline"
                                         Segments="{x:Bind Vm.Hero.UsageTimelineSegments, Mode=OneWay}"
                                         SegmentPreviewed="OnUsageTimelineSegmentPreviewed"
                                         SegmentPreviewEnded="OnUsageTimelineSegmentPreviewEnded"
                                         SegmentInvoked="OnUsageTimelineSegmentInvoked" />
                </Border>

                <!-- Card ordering -->
                <Grid AutomationProperties.AutomationId="SortModeBar"
                      Margin="0,-4,0,-2">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Vm.SortTitle}"
                                   Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" />
                        <controls:SelectorBar x:Name="SortSelector"
                                              SelectionChanged="OnSortSelectorSelectionChanged"
                                              AutomationProperties.AutomationId="SortSelector">
                            <controls:SelectorBarItem x:Name="SortByPlanValueItem"
                                                      Text="{x:Bind Vm.SortByPlanValueTitle}"
                                                      IsSelected="True"
                                                      AutomationProperties.AutomationId="SortByPlanValueItem" />
                            <controls:SelectorBarItem x:Name="SortByResetFrequencyItem"
                                                      Text="{x:Bind Vm.SortByResetFrequencyTitle}"
                                                      AutomationProperties.AutomationId="SortByResetFrequencyItem" />
                            <controls:SelectorBarItem x:Name="SortByNextResetItem"
                                                      Text="{x:Bind Vm.SortByNextResetTitle}"
                                                      AutomationProperties.AutomationId="SortByNextResetItem" />
                        </controls:SelectorBar>
                    </StackPanel>
                </Grid>

                <!-- Provider cards -->
                <ItemsControl x:Name="ProviderCardsControl"
                               ItemsSource="{x:Bind Vm.Providers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:AdaptiveProviderCardsPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderItemViewModel">
                            <views:ProviderCard ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Add provider -->
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{x:Bind Vm.AddProviderCommand}"
                        AutomationProperties.AutomationId="AddProviderButton"
                        AutomationProperties.Name="{x:Bind Vm.AddProviderTitle}"
                        Style="{StaticResource SubtleButtonStyle}" CornerRadius="8" Padding="0,10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock Text="{x:Bind Vm.AddProviderTitle}" />
                    </StackPanel>
                </Button>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== Settings page ===== -->
        <ScrollViewer x:Name="SettingsRoot" Grid.Row="1" Visibility="Collapsed"
                      AutomationProperties.AutomationId="SettingsRoot"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="SettingsContent" HorizontalAlignment="Center">
                <StackPanel Spacing="14" Margin="16,8,16,16">
                <TextBlock x:Name="SettingsHeading" Style="{StaticResource SubtitleTextBlockStyle}" />

                <!-- Refresh-interval row, styled like a native Windows 11 settings card. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid x:Name="RefreshIntervalSettingsRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Leading glyph in a tinted tile. -->
                        <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <FontIcon FontSize="16" Glyph="&#xE916;"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>

                        <!-- Title + description. -->
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsRowTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="SettingsHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- The control sits on the right, the Fluent settings-card convention. -->
                        <controls:NumberBox Grid.Column="2" x:Name="IntervalBox"
                                   AutomationProperties.AutomationId="RefreshIntervalBox"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LabeledBy="{x:Bind SettingsRowTitle}"
                                   Minimum="30" SpinButtonPlacementMode="Inline"
                                   SmallChange="30" LargeChange="300"
                                   Width="160" />
                    </Grid>
                </Border>

                <!-- Empty threshold row, styled like a native Windows 11 settings card. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid x:Name="EmptyThresholdSettingsRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Leading glyph in a tinted tile. -->
                        <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <FontIcon FontSize="16" Glyph="&#xE1E9;"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>

                        <!-- Title + description. -->
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ThresholdRowTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="ThresholdHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- The control sits on the right, the Fluent settings-card convention. -->
                        <controls:NumberBox Grid.Column="2" x:Name="ThresholdBox"
                                   AutomationProperties.AutomationId="EmptyThresholdBox"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LabeledBy="{x:Bind ThresholdRowTitle}"
                                   Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline"
                                   SmallChange="1" LargeChange="10"
                                   Width="160" />
                    </Grid>
                </Border>

                <!-- Empty provider sort row. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid x:Name="DeprioritizeEmptySettingsRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <FontIcon FontSize="16" Glyph="&#xE9D9;"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DeprioritizeEmptyRowTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DeprioritizeEmptyHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2"
                                      x:Name="DeprioritizeEmptyToggle"
                                      AutomationProperties.AutomationId="DeprioritizeEmptyProvidersToggle"
                                      AutomationProperties.LabeledBy="{x:Bind DeprioritizeEmptyRowTitle}"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Startup row. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid x:Name="LaunchAtStartupSettingsRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <FontIcon FontSize="16" Glyph="&#xE7C3;"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="LaunchAtStartupRowTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="LaunchAtStartupHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2"
                                      x:Name="LaunchAtStartupToggle"
                                      AutomationProperties.AutomationId="LaunchAtStartupToggle"
                                      AutomationProperties.LabeledBy="{x:Bind LaunchAtStartupRowTitle}"
                                      Toggled="OnLaunchAtStartupToggled"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Startup presentation row. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid x:Name="StartHiddenAtStartupSettingsRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <FontIcon FontSize="16" Glyph="&#xE7E8;"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="StartHiddenAtStartupRowTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="StartHiddenAtStartupHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2"
                                      x:Name="StartHiddenAtStartupToggle"
                                      AutomationProperties.AutomationId="StartHiddenAtStartupToggle"
                                      AutomationProperties.LabeledBy="{x:Bind StartHiddenAtStartupRowTitle}"
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Sort priority row. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid x:Name="SortPrioritySettingsRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <FontIcon FontSize="16" Glyph="&#xE8AB;"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SortPriorityRowTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="SortPriorityHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    x:Name="SortPriorityPanel"
                                    AutomationProperties.AutomationId="SortPriorityList"
                                    Width="240"
                                    Spacing="4"
                                    VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Plan value rules row. -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                    BorderThickness="1">
                                <FontIcon FontSize="16" Glyph="&#xE1D3;"
                                          AutomationProperties.AccessibilityView="Raw" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="PlanValueRulesRowTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="PlanValueRulesHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="PlanValueRulesPanel"
                              AutomationProperties.AutomationId="PlanValueRulesList"
                              ColumnSpacing="12"
                              RowSpacing="8" />
                    </StackPanel>
                </Border>

                <!-- Default launch editor row. -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid x:Name="DefaultLaunchEditorSettingsRow" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1">
                            <FontIcon FontSize="16" Glyph="&#xE8A7;"
                                      AutomationProperties.AccessibilityView="Raw" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DefaultLaunchEditorRowTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="DefaultLaunchEditorHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid x:Name="DefaultLaunchEditorControls"
                              Grid.Column="2"
                              ColumnSpacing="6"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DefaultLaunchEditorBox"
                                     AutomationProperties.AutomationId="DefaultLaunchEditorBox"
                                     AutomationProperties.LabeledBy="{x:Bind DefaultLaunchEditorRowTitle}"
                                     PlaceholderText="C:\Path\To\Editor.exe" />
                            <Button Grid.Column="1"
                                    x:Name="BrowseDefaultLaunchEditorButton"
                                    AutomationProperties.AutomationId="BrowseDefaultLaunchEditorButton"
                                    Click="OnBrowseDefaultLaunchEditor"
                                    Style="{StaticResource CardIconButton}">
                                <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                <ToolTipService.ToolTip>
                                    <TextBlock x:Name="BrowseDefaultLaunchEditorToolTipText" />
                                </ToolTipService.ToolTip>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Desktop-app launch paths (global, one per provider type). -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="LaunchPathsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="LaunchPathsHint" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="LaunchPathsPanel" Spacing="8" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveSettingsButton"
                            AutomationProperties.AutomationId="SaveSettingsButton"
                            Click="OnSaveSettings"
                            Style="{StaticResource AccentButtonStyle}"
                            CornerRadius="{StaticResource ControlCornerRadius}" />
                    <Button x:Name="CancelSettingsButton"
                            AutomationProperties.AutomationId="CancelSettingsButton"
                            Click="OnCloseSettings"
                            Style="{StaticResource CardActionButton}" />
                </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
