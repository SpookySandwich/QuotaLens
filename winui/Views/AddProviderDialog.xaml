<ContentDialog
    x:Class="QuotaLens.Views.AddProviderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:QuotaLens.ViewModels"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    CornerRadius="{StaticResource OverlayCornerRadius}"
    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
    BorderThickness="1"
    DefaultButton="None"
    Opened="OnDialogOpened"
    CloseButtonStyle="{StaticResource CardActionButton}">
    <ContentDialog.Background>
        <AcrylicBrush TintColor="#2B2725"
                      TintOpacity="0.86"
                      TintLuminosityOpacity="0.72"
                      FallbackColor="#242120" />
    </ContentDialog.Background>

    <ContentDialog.Resources>
        <!-- Scoped to this dialog. 576 leaves a margin of backdrop at the 620 DIP
             default window and still clamps cleanly at the 520 DIP minimum. -->
        <x:Double x:Key="ContentDialogMinWidth">400</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">576</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">656</x:Double>
        <Thickness x:Key="ContentDialogPadding">24</Thickness>

        <!-- The grouped CollectionViewSource lives in code-behind: a resource entry
             cannot be x:Named in WinUI, and it is rebuilt on every refresh anyway. -->

        <!-- No ControlTemplate: hover, pressed, selection and the focus ring all come
             from the stock GridViewItem, which is what keeps this looking like Windows.
             Margin separates the hover fills so three columns don't read as one slab. -->
        <Style x:Key="ProviderRowContainerStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            <Setter Property="FocusVisualMargin" Value="-2" />
        </Style>

        <!-- GridViewHeaderItem, not ListViewHeaderItem: this is a GridView. -->
        <Style x:Key="ProviderGroupHeaderContainerStyle" TargetType="GridViewHeaderItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="ProviderRowTemplate" x:DataType="vm:ProviderAddOption">
            <!-- The row prints only the name; tooltip and automation carry the
                 setup kind that used to be repeated on every card. -->
            <Grid Padding="8,0" ColumnSpacing="9" Background="Transparent"
                  ToolTipService.ToolTip="{x:Bind RowTooltip}"
                  AutomationProperties.Name="{x:Bind AccessibleLabel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Neutral chip, brand color as INK. Windows uses color as ink on a
                     neutral surface; a grid of saturated fills reads as a web logo
                     wall. The chip keeps the monogram optically aligned across rows. -->
                <Border Width="26" Height="26" CornerRadius="6"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                    <TextBlock Text="{x:Bind Monogram}"
                               FontSize="12" FontWeight="SemiBold" CharacterSpacing="-12"
                               Foreground="{x:Bind TileBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap" MaxLines="1"
                           TextTrimming="CharacterEllipsis" />

                <!-- Already tracked: a quiet trailing check, the way Settings marks a
                     current choice — not a badge bubble. Never blocks: adding a second
                     account is legitimate, so the row stays fully clickable. -->
                <FontIcon Grid.Column="2" Glyph="&#xE73E;" FontSize="12"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          VerticalAlignment="Center" Margin="0,0,2,0"
                          Visibility="{x:Bind ShowAddedCheck, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="2" Text="{x:Bind AddedCountText}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,2,0"
                           Visibility="{x:Bind ShowAddedCount, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <!-- The setup kind, said once per section instead of once per row — which
             finally leaves room to say what that setup actually costs you. -->
        <DataTemplate x:Key="ProviderGroupHeaderTemplate" x:DataType="vm:ProviderAddGroup">
            <Border Padding="8,14,8,4"
                    AutomationProperties.Name="{x:Bind AccessibleLabel}">
                <TextBlock Text="{x:Bind Label}"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
            </Border>
        </DataTemplate>
    </ContentDialog.Resources>

    <!-- ContentDialog measures its content at infinite height, so the inner
         ScrollViewer must be disabled or the GridView never scrolls or virtualizes.
         No fixed Width: the host window is 620 DIP by default and a fixed width
         would clip with no horizontal scroll to recover. -->
    <Grid x:Name="PickerRoot"
          MinWidth="352" MaxWidth="528"
          ScrollViewer.VerticalScrollMode="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Height="36">
            <TextBox x:Name="SearchBox"
                     AutomationProperties.AutomationId="ProviderSearchBox"
                     Height="36" Padding="34,6,40,7"
                     CornerRadius="{ThemeResource ControlCornerRadius}"
                     TextChanged="OnSearchTextChanged"
                     KeyDown="OnSearchKeyDown" />
            <FontIcon Glyph="&#xE721;" FontSize="14"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="12,0,0,0" IsHitTestVisible="False" />
            <Button x:Name="ClearSearchButton"
                    Style="{StaticResource CardIconButton}" Width="28" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,4,0" Visibility="Collapsed"
                    Click="OnClearSearchClick">
                <FontIcon Glyph="&#xE711;" FontSize="12"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Height="1" Margin="0,12,0,0"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Height is assigned in Opened, clamped against the real window height.
             Fixed, never MaxHeight: the dialog must not resize as you type. -->
        <Grid x:Name="ResultsHost" Grid.Row="2">

            <GridView x:Name="TypeGrid"
                      AutomationProperties.AutomationId="ProviderTypeGrid"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnTypeClick"
                      KeyDown="OnGridKeyDown"
                      CharacterReceived="OnGridCharacterReceived"
                      SizeChanged="OnGridSizeChanged"
                      Padding="0,4,12,8"
                      ItemTemplate="{StaticResource ProviderRowTemplate}"
                      ItemContainerStyle="{StaticResource ProviderRowContainerStyle}"
                      ScrollViewer.IsVerticalScrollChainingEnabled="False"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- ItemWidth is a bring-up default only; OnGridSizeChanged
                             recomputes it so the grid fills the track exactly and
                             never silently drops a column. -->
                        <ItemsWrapGrid Orientation="Horizontal"
                                       ItemWidth="172" ItemHeight="48"
                                       GroupHeaderPlacement="Top"
                                       GroupPadding="0,0,0,10"
                                       AreStickyGroupHeadersEnabled="False" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.GroupStyle>
                    <GroupStyle HeaderTemplate="{StaticResource ProviderGroupHeaderTemplate}"
                                HeaderContainerStyle="{StaticResource ProviderGroupHeaderContainerStyle}" />
                </GridView.GroupStyle>
            </GridView>

            <!-- Same cell as the grid, so the dialog never resizes when the last
                 match disappears. Only the panel toggles; NoResultsText keeps its
                 automation id findable whenever the panel is shown. -->
            <StackPanel x:Name="NoResultsPanel" Visibility="Collapsed" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,0,0,24">
                <FontIcon Glyph="&#xE721;" FontSize="28"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="NoResultsText"
                           AutomationProperties.AutomationId="ProviderSearchNoMatchesText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="NoResultsHint"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="320" />
                <HyperlinkButton x:Name="ClearSearchLink"
                                 HorizontalAlignment="Center"
                                 Click="OnClearSearchClick" />
            </StackPanel>
        </Grid>
    </Grid>
</ContentDialog>
